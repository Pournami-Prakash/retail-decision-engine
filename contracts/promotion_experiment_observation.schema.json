{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Randomized promotion experiment observation",
  "description": "One row per eligible assigned store-item-week, including zero-sales weeks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id", "category", "store", "upc", "week", "randomization_unit_id",
    "randomization_block", "assignment_source", "randomization_seed", "assigned_arm",
    "assigned_treatment", "assignment_probability", "explicit_discount_depth", "display_flag",
    "feature_flag", "offer_delivered", "regular_price", "offered_price", "units_sold",
    "replacement_unit_cost", "supplier_funding_per_unit", "inventory_on_hand_start",
    "stockout_flag", "baseline_units_8w", "baseline_margin_8w", "basket_margin",
    "category_substitution_units"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "store": {"type": "integer", "minimum": 1},
    "upc": {"type": ["integer", "string"]},
    "week": {"type": "integer"},
    "randomization_unit_id": {"type": "string", "minLength": 1},
    "randomization_block": {"type": "string", "minLength": 1},
    "assignment_source": {"const": "randomized"},
    "randomization_seed": {"type": "integer"},
    "assigned_arm": {"type": "string", "minLength": 1},
    "assigned_treatment": {"type": "integer", "enum": [0, 1]},
    "assignment_probability": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "explicit_discount_depth": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "display_flag": {"type": "boolean"},
    "feature_flag": {"type": "boolean"},
    "offer_delivered": {"type": "boolean"},
    "regular_price": {"type": "number", "exclusiveMinimum": 0},
    "offered_price": {"type": "number", "exclusiveMinimum": 0},
    "units_sold": {"type": "number", "minimum": 0},
    "replacement_unit_cost": {"type": "number", "minimum": 0},
    "supplier_funding_per_unit": {"type": "number", "minimum": 0},
    "inventory_on_hand_start": {"type": "number", "minimum": 0},
    "stockout_flag": {"type": "boolean"},
    "baseline_units_8w": {"type": "number", "minimum": 0},
    "baseline_margin_8w": {"type": "number"},
    "basket_margin": {"type": "number"},
    "category_substitution_units": {"type": "number"}
  }
}
